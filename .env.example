APP_NAME=FIXA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Supabase: Project Settings > Database > Connection string (Session pooler).
# Nunca subas los valores reales al repositorio.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
DB_SEARCH_PATH=public,extensions

# R01 / RNF07: sesion de 15 minutos de inactividad.
SESSION_DRIVER=file
SESSION_LIFETIME=15
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# En produccion (HTTPS) poner en true.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@fixa.test"
MAIL_FROM_NAME="${APP_NAME}"

# Correo real: MAIL_MAILER=mailgun. Se usa la API porque Render gratis bloquea SMTP.
# Con el dominio sandbox, MAIL_FROM_ADDRESS debe ser postmaster@ de ese dominio.
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net

# API en C# (Fixa_API). La clave es la MISMA que Jwt__Clave de la API: con ella el panel
# firma el token de cada funcionario. Para la API de tu PC: FIXA_API_URL=http://localhost:5112
FIXA_API_URL=https://fixa-api-nhua.onrender.com
FIXA_API_JWT_CLAVE=

# Primer administrador (lo lee AdminSeeder). Contrasena de 12 caracteres o mas.
ADMIN_NOMBRES=
ADMIN_APELLIDOS=
ADMIN_EMAIL=
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"

# Enlace de descarga de la app Android (vacío hasta publicar el APK)
FIXA_APP_URL=
